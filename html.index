  vx=ex/e-ez/e*wa;vz=ez/e+ex/e*wa;sp=z.sp*burst;arm=-1.35-(z.ty=='s'?.1:0);lean=.2+z.sp*.1;
  if(d<1.35&&!cr||d<1.2){z.st='atk';z.tm=0;z.hit=0;groan()}else if(d<5&&d>2.3&&z.cd<0&&R()<dt*1.5){z.st='lunge';z.tm=0;z.h=A2(dx,dz)}}
 if(sp){const n=H(vx,vz)||1;vx/=n;vz/=n;if(z.st!='lunge')z.h+=dA(A2(vx,vz),z.h)*Math.min(1,dt*7);z.x+=vx*sp*dt;z.z+=vz*sp*dt;z.ph+=sp*dt*(cr?3:2.6)}
 if(z.st=='hunt'||z.st=='go'||z.st=='lunge'||z.st=='rec'){push(z,.42);for(const o of zs)if(o!==z&&!o.dead&&o.st!='climb'){const ax=z.x-o.x,az=z.z-o.z,e=H(ax,az);if(e<.8&&e>.01){z.x+=ax/e*(.8-e)*.5;z.z+=az/e*(.8-e)*.5}}}
 m.position.set(z.x,y,z.z);m.rotation.set(cr?1.45:0,z.h,0);const s=Math.sin(z.ph),c=Math.cos(z.ph),q=z.st=='lunge'?.9:cr?.2:.7;
 J.l0.rotation.x=s*q*leg;J.l1.rotation.x=-s*q*leg;J.n0.rotation.x=Math.max(0,-c)*.9*leg;J.n1.rotation.x=Math.max(0,c)*.9*leg;
 if(cr){J.a0.rotation.x=-1.8+s*.7;J.a1.rotation.x=-1.8-s*.7;J.l0.rotation.x=.2;J.l1.rotation.x=-.2}else{J.a0.rotation.x=arm+s*.25;J.a1.rotation.x=arm-s*.25}
 J.e0.rotation.x=-.5;J.e1.rotation.x=-.4;J.to.rotation.x=cr?0:lean;J.to.rotation.z=Math.sin(z.ph*.5+z.wv)*.12;J.hd.rotation.z=Math.sin(T*1.3+z.wv)*.2;J.jw.rotation.x=.25+Math.sin(T*3+z.wv)*.15;J.hip.position.y=.95+(cr?0:Math.abs(s)*.04)}
function hitP(d){if(st!='play')return;hp-=d;noHit=0;dmg=.9;snd(.4,.2,700);if(hp<=0)over()}
function over(){st='over';document.exitPointerLock&&document.exitPointerLock();$('ovt').textContent='ラウンド '+rnd+' まで生き延びた';$('ov').style.display='flex';$('go').textContent='もう一度'}
function startRound(){rnd++;toSpawn=Math.min(60,Math.round(6+(rnd-1)*5.5));zhp=rnd<10?100+rnd*50:Math.round(550*Math.pow(1.1,rnd-9));spT=3;$('rd').textContent=rnd;toast('ラウンド '+rnd);snd(.5,.8,500)}
/* weapon logic */
const wd = () => SL[cur] && GS[SL[cur].id];

let muzzleTime = 0;
let fireHeld = false;
let semiQueued = false;

const buttonPointers = new Map();
const heldKeys = new Set();

function clearInput() {
  for (const key of Object.keys(K)) delete K[key];
  for (const id of Object.keys(TS)) delete TS[id];

  heldKeys.clear();
  buttonPointers.clear();

  drag = 0;
  fireHeld = false;
  semiQueued = false;
}

function syncCamera() {
  cam.position.set(
    P.x,
    1.7 + P.y + Math.sin(bob) * .04,
    P.z
  );

  // 前進方向 sin(yaw), -cos(yaw) と視線を一致させる。
  cam.rotation.set(pit, -yaw, 0);
  cam.updateMatrixWorld(true);
}

function resumeAudio() {
  try {
    if (!AC || AC.state === 'closed') {
      const AudioClass =
        window.AudioContext || window.webkitAudioContext;

      if (!AudioClass) return;
      AC = new AudioClass();
    }

    if (AC.state === 'suspended') {
      const result = AC.resume();
      if (result && result.catch) result.catch(() => {});
    }
  } catch (error) {
    console.warn('音声を開始できませんでした。', error);
  }
}

function requestMouseLock() {
  if (!cv.requestPointerLock) return;
  if (document.pointerLockElement === cv) return;

  try {
    const result = cv.requestPointerLock();
    if (result && result.catch) {
      result.catch(() => {
        // 非対応環境ではドラッグによる視点操作を残す。
      });
    }
  } catch (_) {
    // ポインターロックが拒否されてもゲームは続ける。
  }
}

function selW(i) {
  if (st !== 'play' || i === cur || !SL[i]) return;

  cur = i;
  rl = 0;
  swK = 1;
  fT = .3;
  muzzleTime = 0;
  semiQueued = false;

  vmLoad();
}

function reload() {
  if (st !== 'play') return;

  const w = wd();
  const s = SL[cur];

  if (!w || !s || rl > 0 || s.mag >= w.mag || s.res <= 0) {
    return;
  }

  rl = w.rel;
  semiQueued = false;
  muzzleTime = 0;

  snd(.15, .08, 5000);
}

function hm() {
  $('hm').style.opacity = 1;
  hmT = .12;
}

function shoot(w, s) {
  if (st !== 'play' || s.mag <= 0) return;

  // 入力と移動を反映した、現在の視点から撃つ。
  // この弾を撃った後に反動を適用する。
  syncCamera();

  s.mag--;
  fT = w.rate;
  muzzleTime = .04;

  const origin = cam.position.clone();
  const forward = new THREE.Vector3();
  cam.getWorldDirection(forward);

  // 描画中の銃モデルと同じ変換を使って銃口を求める。
  updateWeaponPose();
  cam.updateMatrixWorld(true);

  const muzzle = new THREE.Vector3(0, .01, w.mz);
  vm.localToWorld(muzzle);

  const spread =
    w.sp *
    (1 - adsK * .6) *
    (1 + Math.min(1, H(P.vx, P.vz) / 6) * 1.5);

  for (let k = 0; k < w.pel; k++) {
    const direction = forward.clone();

    direction.x += rr(-spread, spread);
    direction.y += rr(-spread, spread);
    direction.z += rr(-spread, spread);
    direction.normalize();

    let best = rayMap(origin, direction);
    let hitZombie = null;
    let headshot = false;

    for (const z of zs) {
      if (z.dead || z.gone) continue;

      const crawling = z.ty === 'c';
      const scale = z.sc;

      // 窓乗り越え・飛びかかり時の高さも加味する。
      const elevation =
        z.m.position.y - (crawling ? .3 : 0);

      const headDistance = rs3(
        origin, direction,
        z.x,
        (crawling ? .55 : 1.68 * scale) + elevation,
        z.z,
        .2 * scale
      );

      const bodyDistance = rs3(
        origin, direction,
        z.x,
        (crawling ? .4 : 1.2 * scale) + elevation,
        z.z,
        .4 * scale
      );

      const legDistance = crawling
        ? 1e9
        : rs3(
            origin, direction,
            z.x, .55 * scale + elevation, z.z,
            .36 * scale
          );

      const distance = Math.min(
        headDistance,
        bodyDistance,
        legDistance
      );

      if (distance < best) {
        best = distance;
        hitZombie = z;
        headshot =
          headDistance <= bodyDistance &&
          headDistance <= legDistance;
      }
    }

    const end = origin.clone().addScaledVector(direction, best);
    tracer(muzzle, end);

    if (hitZombie) {
      hurtZ(
        hitZombie,
        w.dmg * (w.pel > 1 ? .55 : 1),
        headshot
      );
      hm();
    } else if (best < 300) {
      // 射程端の空中には着弾粒子を出さない。
      fx(end.x, end.y, end.z, 4, 4, 0xcfc3a0, .3);
    }
  }

  recoil = Math.min(1, recoil + w.rec * 12);

  pit = cl(
    pit + w.rec * (1 - adsK * .5) * (.7 + R() * .6),
    -1.4,
    1.4
  );

  yaw += rr(-.3, .3) * w.rec;
  snd(...w.sn);
}

function wallAct(dt, press) {
  if (st !== 'play') {
    $('pr').style.opacity = 0;
    return;
  }

  let text = '';
  let near = null;
  let repairing = false;

  for (const b of BUY) {
    if (H(P.x - b.wx, P.z - b.wz) < 2.4) {
      near = b;
      break;
    }
  }

  if (near) {
    const own = SL.find(s => s && s.id === near.id);
    const price = own
      ? Math.round(near.price / 2)
      : near.price;

    text =
      (own
        ? 'E: 弾薬購入 '
        : 'E: ' + GS[near.id].n + ' 購入 ') +
      '$' + price;

    if (press) {
      // 元コードの予備弾数上限を維持する。
      const reserveMax =
        GS[near.id].res + GS[near.id].mag;

      if (own && own.res >= reserveMax) {
        toast('予備弾薬は満タンです');
      } else if (pts < price) {
        toast('ポイントが足りない');
      } else {
        pts -= price;

        if (own) {
          own.res = reserveMax;
        } else {
          const index = SL[1] ? cur : 1;

          SL[index] = {
            id: near.id,
            mag: GS[near.id].mag,
            res: GS[near.id].res
          };

          cur = index;

          // 交換前の武器のリロードを引き継がない。
          rl = 0;
          fT = .3;
          swK = 1;
          muzzleTime = 0;
          semiQueued = false;

          vmLoad();
        }

        snd(.2, .1, 4000);
      }
    }
  } else {
    for (const w of WIN) {
      const dx = P.x - w.x;
      const dz = P.z - w.z;

      if (
        H(dx, dz) < 3 &&
        dx * w.ox + dz * w.oz < 0 &&
        w.n < 3
      ) {
        text = 'E長押し: バリケード修理';

        if (K.KeyE) {
          repairing = true;
          rep_ -= dt;

          if (rep_ <= 0 && w.n < w.bd.length) {
            rep_ = .7;
            w.bd[w.n].visible = true;
            w.n++;
            pts += 10;

            snd(.3, .1, 1200);
          }
        }

        break;
      }
    }
  }

  if (!repairing) rep_ = 0;

  if (text !== lastPr) {
    lastPr = text;
    $('pr').textContent = text;
  }

  $('pr').style.opacity = text ? 1 : 0;
}

/* viewmodel */
const vm = new THREE.Group();

const flash = new THREE.Sprite(
  new THREE.SpriteMaterial({
    map: halo,
    color: new THREE.Color(4, 2.4, .8),
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    transparent: true,
    fog: false
  })
);

const fL = new THREE.PointLight(0xffa850, 0, 12, 2);

flash.scale.setScalar(.28);
flash.visible = false;

vm.add(flash, fL);
cam.add(vm);

let cg = null;

function vmLoad() {
  if (cg) vm.remove(cg);

  cg = mkGun(SL[cur].id);
  vm.add(cg);

  muzzleTime = 0;
  flash.visible = false;
  fL.intensity = 0;
}

function updateWeaponPose() {
  const w = wd();
  if (!w) return;

  const reloadMotion = rl > 0
    ? Math.sin(cl((w.rel - rl) / w.rel, 0, 1) * PI)
    : 0;

  vm.position.set(
    .17 * (1 - adsK) +
      Math.sin(bob * .5) * .004 * (1 - adsK) +
      sprK * .08,

    -.11 * (1 - adsK) -
      w.ads * adsK -
      .09 * reloadMotion -
      .2 * swK +
      Math.sin(bob) * .004 * (1 - adsK) -
      sprK * .06,

    w.vz + recoil * .07
  );

  vm.rotation.set(
    recoil * .3 + .45 * reloadMotion + sprK * .25,
    sprK * .5,
    -sprK * .2
  );

  // vm自体がすでにw.vzの位置にあるため、
  // 子の銃口にはw.vzを重ねて加算しない。
  flash.position.set(0, .01, w.mz);
  fL.position.copy(flash.position);
}

function vmu(dt) {
  const w = wd();
  const s = SL[cur];

  if (!w || !s) return;

  updateWeaponPose();

  const firing = st === 'play' && muzzleTime > 0;
  flash.visible = firing;
  fL.intensity = firing ? 8 : 0;

  if (firing) flash.material.rotation = R() * PI * 2;

  $('am').innerHTML =
    w.n + '　' + s.mag +
    '<small>/ ' + s.res +
    (rl > 0 ? '　リロード中' : '') +
    '</small>';
}

/* input */
const cv = $('g');
// マウスは左右ボタンの同時押しを個別に検出する。
cv.addEventListener('mousedown', event => {
  if (st !== 'play') return;
  if (event.button !== 0 && event.button !== 2) return;

  event.preventDefault();
  resumeAudio();

  if (event.button === 2) {
    K.Ads = 1;
    return;
  }

  // 左クリック：エイム中も射撃入力を受け付ける。
  fireHeld = true;
  refreshButtonKey('Fire');
  queueFire();

  if (document.pointerLockElement !== cv) {
    drag = 1;
    requestMouseLock();
  }
});

window.addEventListener('mouseup', event => {
  if (event.button === 0) {
    fireHeld = false;
    drag = 0;
    refreshButtonKey('Fire');
  }

  if (event.button === 2) {
    K.Ads = 0;
  }
});

const inp = () => {
  let jx = 0;
  let jy = 0;

  for (const id in TS) {
    const touch = TS[id];

    if (touch.l) {
      jx = cl((touch.x - touch.x0) / 45, -1, 1);
      jy = cl((touch.y - touch.y0) / 45, -1, 1);
      break;
    }
  }

  return [
    cl(jx + (K.KeyD ? 1 : 0) - (K.KeyA ? 1 : 0), -1, 1),
    cl(jy + (K.KeyS ? 1 : 0) - (K.KeyW ? 1 : 0), -1, 1),
    jy
  ];
};

function queueFire() {
  // セミオートは押した瞬間を記録する。
  // 自動リピートのkeydownでは発砲を追加しない。
  semiQueued = true;
}

function runAction(key) {
  if (key === 'KeyE') wallAct(0, true);
  if (key === 'KeyR') reload();
  if (key === 'Digit1') selW(0);
  if (key === 'Digit2') selW(1);
  if (key === 'Digit0') selW(1 - cur);
  if (key === 'Fire' || key === 'KeyF') queueFire();
}

function refreshButtonKey(key) {
  let down = heldKeys.has(key);

  for (const pressedKey of buttonPointers.values()) {
    if (pressedKey === key) down = true;
  }

  if (key === 'Fire' && fireHeld) down = true;
  K[key] = down ? 1 : 0;
}

addEventListener('keydown', event => {
  if (st !== 'play') return;

  if (
    event.code === 'Space' ||
    event.code.startsWith('Arrow')
  ) {
    event.preventDefault();
  }

  if (event.repeat) return;

  heldKeys.add(event.code);
  K[event.code] = 1;
  runAction(event.code);
});

addEventListener('keyup', event => {
  heldKeys.delete(event.code);
  refreshButtonKey(event.code);
});

addEventListener('contextmenu', event => {
  event.preventDefault();
});

addEventListener('wheel', event => {
  if (st !== 'play') return;
  event.preventDefault();
  selW(1 - cur);
}, { passive: false });

cv.addEventListener('pointerdown', event => {
  // マウスは上のmousedownで処理するため二重入力を防ぐ。
  if (event.pointerType === 'mouse') return;
  if (st !== 'play') return;

  resumeAudio();


  if (event.pointerType === 'touch') {
    event.preventDefault();

    const left = event.clientX < innerWidth / 2;

    // 同じ操作領域を複数の指が奪い合わないようにする。
    if (Object.values(TS).some(t => t.l === left)) return;

    TS[event.pointerId] = {
      l: left,
      x0: event.clientX,
      y0: event.clientY,
      x: event.clientX,
      y: event.clientY
    };

    try {
      cv.setPointerCapture(event.pointerId);
    } catch (_) {}

    return;
  }

  if (event.button === 2) {
    K.Ads = 1;
    return;
  }

  if (event.button !== 0) return;

  if (document.pointerLockElement === cv) {
    fireHeld = true;
    K.Fire = 1;
    queueFire();
  } else {
    drag = 1;
    requestMouseLock();
  }
});

cv.addEventListener('pointermove', event => {
  if (st !== 'play') return;

  const touch = TS[event.pointerId];

  if (touch) {
    if (!touch.l) {
      const sensitivity = .006 * (1 - adsK * .5);

      yaw += (event.clientX - touch.x) * sensitivity;
      pit = cl(
        pit - (event.clientY - touch.y) * sensitivity,
        -1.4,
        1.4
      );
    }

    touch.x = event.clientX;
    touch.y = event.clientY;
  } else if (
    drag ||
    document.pointerLockElement === cv
  ) {
    const sensitivity = .0025 * (1 - adsK * .5);

    yaw += (event.movementX || 0) * sensitivity;
    pit = cl(
      pit - (event.movementY || 0) * sensitivity,
      -1.4,
      1.4
    );
  }
});

function releasePointer(event) {
  // マウスの各ボタンはmouseupで個別に解除する。
  if (event.pointerType === 'mouse') return;

  delete TS[event.pointerId];


  const key = buttonPointers.get(event.pointerId);
  if (key) {
    buttonPointers.delete(event.pointerId);
    refreshButtonKey(key);
  }

  if (event.pointerType !== 'touch') {
    if (
      event.button === 0 ||
      event.type === 'pointercancel'
    ) {
      drag = 0;
      fireHeld = false;
      refreshButtonKey('Fire');
    }

    if (
      event.button === 2 ||
      event.type === 'pointercancel'
    ) {
      K.Ads = 0;
    }
  }
}

addEventListener('pointerup', releasePointer);
addEventListener('pointercancel', releasePointer);

cv.addEventListener('lostpointercapture', event => {
  delete TS[event.pointerId];
});

document.querySelectorAll('[data-k]').forEach(button => {
  const key = button.dataset.k;

  button.onpointerdown = event => {
    event.preventDefault();
    event.stopPropagation();

    if (st !== 'play') return;

    resumeAudio();

    const wasDown = !!K[key];

    buttonPointers.set(event.pointerId, key);
    refreshButtonKey(key);

    try {
      button.setPointerCapture(event.pointerId);
    } catch (_) {}

    if (!wasDown) runAction(key);
  };

  button.onpointerup = releasePointer;
  button.onpointercancel = releasePointer;

  button.onlostpointercapture = event => {
    if (!buttonPointers.has(event.pointerId)) return;

    buttonPointers.delete(event.pointerId);
    refreshButtonKey(key);
  };

  // 指がボタン外へ動いても、離すまでは保持する。
  button.onpointerleave = null;
});

addEventListener('blur', clearInput);

document.addEventListener('visibilitychange', () => {
  clearInput();
  last = performance.now();
});

document.addEventListener('pointerlockchange', () => {
  if (document.pointerLockElement !== cv) clearInput();
});

/* restart cleanup */
function disposeZombieMaterials(z) {
  if (z.materialsDisposed) return;
  z.materialsDisposed = true;

  const materials = new Set();

  z.m.traverse(object => {
    if (!object.isMesh) return;

    const list = Array.isArray(object.material)
      ? object.material
      : [object.material];

    for (const material of list) {
      // 目と靴は共有マテリアルなので解放しない。
      if (
        material &&
        material !== mEye &&
        material !== mDk
      ) {
        materials.add(material);
      }
    }
  });

  materials.forEach(material => material.dispose());

  // ジオメトリとテクスチャは全個体で共有しているため維持。
}

function reset() {
  clearInput();

  for (const z of zs) {
    scene.remove(z.m);
    disposeZombieMaterials(z);
  }
  zs.length = 0;

  for (const [mesh] of trs) scene.remove(mesh);
  trs.length = 0;
  parts.length = 0;

  WIN.forEach(w => {
    w.n = 3;
    w.tc = 0;
    w.bd.forEach(board => board.visible = true);
  });

  Object.assign(P, {
    x: 0,
    z: 8,
    y: 0,
    vy: 0,
    vx: 0,
    vz: 0
  });

  pts = 500;
  hp = 100;
  noHit = 0;
  dmg = 0;

  rnd = 0;
  alive = 0;
  toSpawn = 0;
  spT = 0;
  zhp = 150;
  rT = -1;

  // 元の初期カメラが向いていた方向を維持する。
  yaw = -PI / 2;
  pit = 0;
  bob = 0;
  T = 0;

  cur = 0;
  fT = 0;
  rl = 0;
  adsK = 0;
  recoil = 0;
  sprK = 0;
  swK = 0;
  hmT = 0;
  rep_ = 0;
  muzzleTime = 0;
  lastPr = '';

  SL[0] = {
    id: 'm1911',
    mag: GS.m1911.mag,
    res: GS.m1911.res
  };
  SL[1] = null;

  clearTimeout(tt);

  $('hm').style.opacity = 0;
  $('dm').style.opacity = 0;
  $('pr').style.opacity = 0;
  $('pr').textContent = '';
  $('toast').style.opacity = 0;
  $('ovt').textContent = '';

  vmLoad();

  st = 'play';
  go = 1;

  syncCamera();
  vmu(0);
  startRound();
}

$('go').onclick = event => {
  resumeAudio();
  reset();

  $('ov').style.display = 'none';

  // タッチ開始時にはマウス用ロックを要求しない。
  if (
    event.pointerType !== 'touch' &&
    matchMedia('(pointer: fine)').matches
  ) {
    requestMouseLock();
  }
};

/* main */
function step(dt) {
  T += dt;
  muzzleTime = Math.max(0, muzzleTime - dt);

  if (st !== 'play') return;

  const [ix, iy, jy] = inp();
  const w = wd();
  const s = SL[cur];

  const aimRequested = !!(K.Ads || K.KeyQ);

const sprint = !!(
  !aimRequested &&
  (K.ShiftLeft || K.ShiftRight || jy < -.95) &&
  iy < 0 &&
  adsK < .2
);


  const speed =
    (sprint ? 6.6 : 4.4) * (1 - adsK * .4);

  // 斜め移動だけ正規化し、小さな入力はそのまま残す。
  const length = H(ix, iy);
  const divisor = Math.max(1, length);
  const forward = -iy / divisor;
  const sideways = ix / divisor;
  const cos = Math.cos(yaw);
  const sin = Math.sin(yaw);

  P.vx = (sin * forward + cos * sideways) * speed;
  P.vz = (-cos * forward + sin * sideways) * speed;

  P.x += P.vx * dt;
  P.z += P.vz * dt;

  bob += speed * Math.min(1, length) * dt * 1.9;

  if (K.Space && P.y <= 0) P.vy = 5.2;

  P.vy -= 14 * dt;
  P.y = Math.max(0, P.y + P.vy * dt);

  if (P.y === 0 && P.vy < 0) P.vy = 0;

  push(P, .4);

  P.x = cl(P.x, -31, 31);
  P.z = cl(P.z, -23, 23);

  fT -= dt;
  hmT -= dt;

  if (hmT <= 0) $('hm').style.opacity = 0;

  adsK += (
  (aimRequested ? 1 : 0) - adsK
) * Math.min(1, dt * 10);


  sprK += (
    (sprint ? 1 : 0) - sprK
  ) * Math.min(1, dt * 8);

  swK = Math.max(0, swK - dt * 4);
  recoil *= Math.pow(.001, dt);
  dmg *= Math.pow(.15, dt);

  noHit += dt;
  if (noHit > 5 && hp < 100) {
    hp = Math.min(100, hp + dt * 40);
  }

  if (rl > 0) {
    rl -= dt;

    if (rl <= 0) {
      rl = 0;

      const amount = Math.max(
        0,
        Math.min(w.mag - s.mag, s.res)
      );

      s.mag += amount;
      s.res -= amount;
    }
  }

  const wantsFire = w.auto
    ? !!(K.Fire || K.KeyF || semiQueued)
    : semiQueued;

  if (
    wantsFire &&
    fT <= 0 &&
    rl <= 0 &&
    !sprint &&
    swK < .3
  ) {
    semiQueued = false;

    if (s.mag > 0) shoot(w, s);
    else reload();
  }

  // リロード中・ダッシュ中の単発入力は持ち越さない。
  if (rl > 0 || sprint) semiQueued = false;

  for (let i = trs.length - 1; i >= 0; i--) {
    trs[i][1] -= dt;

    if (trs[i][1] <= 0) {
      scene.remove(trs[i][0]);
      trs.splice(i, 1);
    }
  }

  spT -= dt;

  if (toSpawn > 0 && alive < 16 && spT <= 0) {
    spawnZ();
    toSpawn--;
    spT = Math.max(.7, 2.4 - rnd * .13);
  }

  if (toSpawn === 0 && alive === 0) {
    if (rT < 0) rT = 6;

    rT -= dt;

    if (rT <= 0) {
      rT = -1;
      startRound();
    }
  }

  for (let i = zs.length - 1; i >= 0; i--) {
    const z = zs[i];

    updZ(z, dt);

    if (z.gone) {
      disposeZombieMaterials(z);
      zs.splice(i, 1);
    }

    if (st !== 'play') {
      clearInput();
      muzzleTime = 0;
      break;
    }
  }

  wallAct(dt, false);

  const particleDrag = Math.pow(.97, dt * 60);

  for (const particle of parts) {
    particle.l -= dt;
    particle.x += particle.vx * dt;
    particle.y = Math.max(
      0,
      particle.y + particle.vy * dt
    );
    particle.z += particle.vz * dt;
    particle.vy -= 9 * dt;
    particle.vx *= particleDrag;
    particle.vz *= particleDrag;
  }

  for (let i = parts.length - 1; i >= 0; i--) {
    if (parts[i].l <= 0) parts.splice(i, 1);
  }

  if (parts.length > PN) {
    parts.splice(0, parts.length - PN);
  }
}

// 毎フレーム追加し直さず、一度だけシーンに登録する。
scene.add(moon.target);

function view(dt) {
  syncCamera();

  const fov = 75 - adsK * 20 + sprK * 4;
  if (Math.abs(cam.fov - fov) > .001) {
    cam.fov = fov;
    cam.updateProjectionMatrix();
  }

  dome.position.copy(cam.position);

  moon.position.set(P.x, 90, P.z + 70);
  moon.target.position.set(P.x, 0, P.z);
  moon.target.updateMatrixWorld();

  for (let k = 0; k < PN; k++) {
    const particle = parts[k];
    const offset = k * 3;

    if (particle) {
      pa[offset] = particle.x;
      pa[offset + 1] = particle.y;
      pa[offset + 2] = particle.z;

      pc[offset] = particle.r;
      pc[offset + 1] = particle.g;
      pc[offset + 2] = particle.b;
    } else {
      pa[offset] = 0;
      pa[offset + 1] = -999;
      pa[offset + 2] = 0;
    }
  }

  pg.attributes.position.needsUpdate = true;
  pg.attributes.color.needsUpdate = true;

  $('pt').textContent = pts;

  $('dm').style.opacity = Math.min(
    1,
    dmg + (hp < 100 ? (100 - Math.max(0, hp)) / 160 : 0)
  );

  $('ch').style.opacity = adsK > .5 ? 0 : 1;
  $('ch').style.transform =
    'scale(' +
    (
      1 +
      recoil * 2.5 +
      Math.min(1, H(P.vx, P.vz) / 6) * .8
    ) +
    ')';
}

vmLoad();
vmu(0);

let last = 0;

function loop(timestamp) {
  requestAnimationFrame(loop);

  const dt = last
    ? Math.min(.05, Math.max(0, (timestamp - last) / 1000))
    : 1 / 60;

  last = timestamp;

  // 別タブにいる間はゲームの進行を止める。
  if (document.hidden) return;

  if (go) step(dt);

  vmu(dt);
  view(dt);
  rd.render(scene, cam);
}

requestAnimationFrame(loop);
</script>
</body>
</html>
