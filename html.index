
<!DOCTYPE html>
<html lang="ja"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ゾンビ・コンパウンド</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Special+Elite&display=swap">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#0b0d14;--fg:#e9e6dc;--pan:#0009;--blood:#b3121a;--acc:#d9c37a}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#07080d;--pan:#000b}}
:root[data-theme="dark"]{--bg:#07080d;--pan:#000b}
html,body{height:100%;margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 "DotGothic16","Hiragino Sans","Noto Sans JP",system-ui,sans-serif;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none}
#g{display:block;width:100%;height:100%}
.f{position:fixed;pointer-events:none}
#bl{inset:0;background:radial-gradient(ellipse at center,transparent 50%,rgba(0,0,0,.65))}
#dm{inset:0;background:radial-gradient(ellipse at center,transparent 30%,rgba(160,0,0,.9));opacity:0}
#ch{left:50%;top:50%;width:6px;height:6px;margin:-3px;border-radius:50%;background:#fffc;box-shadow:0 0 4px #000}
#hm{left:50%;top:50%;transform:translate(-50%,-50%);font-size:26px;opacity:0;color:#fff;text-shadow:0 0 6px #f00}
#rd{left:14px;bottom:calc(10px + env(safe-area-inset-bottom,0px));font:64px/1 "Special Elite",serif;color:var(--blood);text-shadow:0 0 10px #000,2px 2px 0 #000}
#pt{left:18px;bottom:calc(82px + env(safe-area-inset-bottom,0px));font-size:26px;color:var(--acc);text-shadow:2px 2px 0 #000}
#am{right:16px;bottom:calc(14px + env(safe-area-inset-bottom,0px));text-align:right;font-size:36px;line-height:1.1;text-shadow:2px 2px 0 #000}
#am small{display:block;font-size:14px;opacity:.85}
@media(pointer:coarse){#am{bottom:calc(150px + env(safe-area-inset-bottom,0px))}}
#pr{left:50%;top:64%;transform:translateX(-50%);background:var(--pan);padding:6px 14px;border-radius:8px;opacity:0;white-space:nowrap}
#toast{left:50%;top:calc(24px + env(safe-area-inset-top,0px));transform:translateX(-50%);font-size:26px;color:var(--acc);text-shadow:2px 2px 0 #000;opacity:0;transition:opacity .3s;white-space:nowrap}
#pad{position:fixed;right:0;bottom:0;display:flex;flex-wrap:wrap;justify-content:flex-end;max-width:240px;gap:8px;padding:10px 12px calc(12px + env(safe-area-inset-bottom,0px))}
#pad button{width:58px;height:58px;border-radius:50%;border:2px solid var(--acc);background:var(--pan);color:var(--fg);font:inherit;font-size:15px;touch-action:none}
@media(pointer:fine){#pad{display:none}}
#ov{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(5,6,10,.82);padding:16px;text-align:center}
#ov div{max-width:460px}
h1{margin:0 0 10px;font:34px "Special Elite","DotGothic16",serif;color:var(--blood);text-shadow:0 0 14px #000}
#go{margin-top:14px;padding:12px 44px;font:inherit;font-size:18px;border:0;border-radius:6px;background:var(--blood);color:#fff;cursor:pointer}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script></head><body>
<canvas id="g"></canvas><div id="bl" class="f"></div><div id="dm" class="f"></div><div id="ch" class="f"></div><div id="hm" class="f">✕</div>
<div id="rd" class="f">0</div><div id="pt" class="f"></div><div id="am" class="f"></div><div id="pr" class="f"></div><div id="toast" class="f"></div>
<div id="pad"><button data-k="Fire">🔫</button><button data-k="KeyQ">ADS</button><button data-k="KeyR">R</button><button data-k="KeyE">使う</button><button data-k="Digit0">武器</button><button data-k="Space">⤒</button></div>
<div id="ov"><div><h1>ゾンビ・コンパウンド</h1>
<p>壁の窓をバリケードで守りながら、押し寄せるゾンビを撃ち倒して何ラウンド生き残れるか。<br>撃つ・修理でポイント獲得 → 壁の武器を購入。</p>
<p>WASD 移動　Shift ダッシュ　Space ジャンプ　マウス 視点<br>左クリック/F 発砲　右クリック/Q 構え　R リロード　E 購入・修理（長押し）　1/2・ホイール 武器切替</p>
<p id="ovt"></p><button id="go">スタート</button></div></div>
<script>
const $=i=>document.getElementById(i),R=Math.random,H=Math.hypot,A2=Math.atan2,PI=Math.PI,rr=(a,b)=>a+R()*(b-a),cl=(v,a,b)=>v<a?a:v>b?b:v,ri=n=>(R()*n)|0;
const rd=new THREE.WebGLRenderer({canvas:$('g'),antialias:true});
rd.outputEncoding=THREE.sRGBEncoding;rd.toneMapping=THREE.ACESFilmicToneMapping;rd.toneMappingExposure=1.3;rd.shadowMap.enabled=true;rd.shadowMap.type=THREE.PCFSoftShadowMap;
const scene=new THREE.Scene(),cam=new THREE.PerspectiveCamera(75,1,.04,400);cam.rotation.order='YXZ';scene.add(cam);
function rs(){rd.setPixelRatio(Math.min(devicePixelRatio||1,2));rd.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()}
addEventListener('resize',rs);rs();
/* textures / materials */
const tx=(base,n,o)=>{o=o||{};const c=document.createElement('canvas');c.width=c.height=256;const g=c.getContext('2d');g.fillStyle=base;g.fillRect(0,0,256,256);
 for(let i=0;i<n;i++){g.fillStyle=R()<.5?'rgba(0,0,0,'+rr(.03,.16)+')':'rgba(255,255,255,'+rr(.02,.08)+')';const r=rr(1,o.r||14);g.beginPath();g.ellipse(R()*256,R()*256,r*(o.sx||1),r,0,0,PI*2);g.fill()}
 if(o.l){g.strokeStyle='rgba(0,0,0,.35)';g.lineWidth=2;for(let y=0;y<256;y+=o.l){g.beginPath();g.moveTo(0,y);g.lineTo(256,y);g.stroke()}}
 if(o.b){g.strokeStyle='rgba(0,0,0,.45)';g.lineWidth=3;for(let y=0;y<256;y+=32){g.beginPath();g.moveTo(0,y);g.lineTo(256,y);g.stroke();for(let x=(y/32%2)*32;x<256;x+=64){g.beginPath();g.moveTo(x,y);g.lineTo(x,y+32);g.stroke()}}}
 if(o.w){g.lineWidth=1;for(let i=0;i<80;i++){g.strokeStyle='rgba('+(R()<.5?'30,15,0':'255,220,160')+','+rr(.05,.22)+')';const y=R()*256;g.beginPath();g.moveTo(0,y);g.bezierCurveTo(80,y+rr(-6,6),170,y+rr(-6,6),256,y+rr(-4,4));g.stroke()}}
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;t.wrapS=t.wrapT=THREE.RepeatWrapping;t.anisotropy=8;return t};
const mt=(map,r,m,col)=>new THREE.MeshStandardMaterial({map,roughness:r,metalness:m||0,color:col===undefined?0xffffff:col});
const rep=(t,k)=>{t=t.clone();t.needsUpdate=true;t.repeat.set(k,k);return t};
const T_wood=tx('#5a3a1e',60,{w:1,sx:6}),T_met=tx('#3c3f46',140,{sx:8,r:6}),T_brick=tx('#7b4b3a',220,{b:1,r:8}),T_grass=tx('#2f4527',800,{r:6}),T_conc=tx('#6b6a66',700,{r:10}),T_roof=tx('#2a2a30',260,{l:12,r:6}),T_skin=tx('#778a63',280,{r:16}),T_cloth=tx('#888',320,{r:12}),T_bark=tx('#3a2e24',320,{sx:5,r:5});
const T_wg=rep(T_wood,12),T_mg=rep(T_met,10);
const GM=[mt(T_mg,.35,.9),mt(T_mg,.5,.55,0x777777),mt(null,.75,0,0x18181a),mt(T_wg,.55),mt(null,.3,.9,0xb48a3c),new THREE.MeshBasicMaterial({color:new THREE.Color(.4,2.4,1.6)})];
/* sky / lights */
const sky=(()=>{const c=document.createElement('canvas');c.width=1024;c.height=512;const g=c.getContext('2d');let q=g.createLinearGradient(0,0,0,512);[[0,'#03040e'],[.3,'#0b1030'],[.45,'#2a2a52'],[.495,'#6a4a5a'],[.5,'#8a5a4a'],[.52,'#10121e'],[1,'#05060c']].forEach(s=>q.addColorStop(s[0],s[1]));g.fillStyle=q;g.fillRect(0,0,1024,512);
 for(let i=0;i<380;i++){g.fillStyle='rgba(255,255,255,'+rr(.2,.9)+')';g.fillRect(R()*1024,R()*200,rr(.6,1.8),rr(.6,1.8))}
 q=g.createRadialGradient(256,110,2,256,110,60);q.addColorStop(0,'#fff');q.addColorStop(.12,'rgba(230,240,255,.9)');q.addColorStop(1,'rgba(120,150,255,0)');g.fillStyle=q;g.fillRect(0,0,1024,512);
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;return t})();
const sg=new THREE.SphereGeometry(300,40,20);sg.scale(-1,1,1);const dome=new THREE.Mesh(sg,new THREE.MeshBasicMaterial({map:sky,fog:false,depthWrite:false}));dome.renderOrder=-1;
try{const s2=new THREE.Scene();s2.add(dome);const pm=new THREE.PMREMGenerator(rd);scene.environment=pm.fromScene(s2,0,1,1000).texture;pm.dispose()}catch(e){}
scene.add(dome);scene.fog=new THREE.FogExp2(0x151a2c,.016);
scene.add(new THREE.HemisphereLight(0x6b7fb0,0x1d1a18,.8));
const moon=new THREE.DirectionalLight(0x9db4ff,1.5);moon.castShadow=true;moon.shadow.mapSize.set(2048,2048);const sc=moon.shadow.camera;sc.left=sc.bottom=-42;sc.right=sc.top=42;sc.near=1;sc.far=220;moon.shadow.bias=-.0006;moon.position.set(0,90,70);scene.add(moon);
for(const[x,z]of[[-14,-6],[14,-6],[0,12],[-24,10]]){const l=new THREE.PointLight(0xffa760,1.1,16,2);l.position.set(x,4,z);scene.add(l)}
const halo=(()=>{const c=document.createElement('canvas');c.width=c.height=64;const g=c.getContext('2d'),q=g.createRadialGradient(32,32,0,32,32,32);q.addColorStop(0,'#fff');q.addColorStop(.3,'rgba(255,255,255,.35)');q.addColorStop(1,'rgba(255,255,255,0)');g.fillStyle=q;g.fillRect(0,0,64,64);return new THREE.CanvasTexture(c)})();
/* geometry helpers */
const LT=(p,s)=>new THREE.LatheGeometry(p.map(a=>new THREE.Vector2(a[0],a[1])),s||10);
const RB=(a,b,c)=>{const r=Math.min(a,b,c)*.22,e=r*.7,w=Math.max(.0004,a-2*e),h=Math.max(.0004,b-2*e),d=Math.max(.0004,c-2*e),x=w/2,y=h/2,q=Math.min(r,x*.9,y*.9),s=new THREE.Shape();
 s.moveTo(-x+q,-y);s.lineTo(x-q,-y);s.quadraticCurveTo(x,-y,x,-y+q);s.lineTo(x,y-q);s.quadraticCurveTo(x,y,x-q,y);s.lineTo(-x+q,y);s.quadraticCurveTo(-x,y,-x,y-q);s.lineTo(-x,-y+q);s.quadraticCurveTo(-x,-y,-x+q,-y);
 const g=new THREE.ExtrudeGeometry(s,{depth:d,bevelEnabled:true,bevelThickness:e,bevelSize:e,bevelSegments:2,curveSegments:3});g.translate(0,0,-d/2);return g};
function bxu(w,h,d,sx,sy){const g=new THREE.BoxGeometry(w,h,d),u=g.attributes.uv;for(let k=0;k<u.count;k++){const f=(k/4)|0;u.setXY(k,u.getX(k)*(f<2?d:w)/sx,u.getY(k)*(f==2||f==3?d:h)/sy)}return g}
function mesh(g,m,sh,p){const o=new THREE.Mesh(g,m);o.castShadow=sh!==0;o.receiveShadow=true;(p||scene).add(o);return o}
const AB=[],CC=[];
/* ground */
T_grass.repeat.set(70,70);const gr=mesh(new THREE.PlaneGeometry(400,400),mt(T_grass,1),0);gr.rotation.x=-PI/2;
T_conc.repeat.set(10,8);const cy=mesh(new THREE.PlaneGeometry(64,48),mt(T_conc,.9),0);cy.rotation.x=-PI/2;cy.position.y=.02;
/* perimeter wall with barricaded windows */
const mBr=mt(rep(T_brick,1),.9),mCo=mt(T_conc,.85),mPl=mt(T_wood,.8),WIN=[];
function seg(ax,f,s,e){const L=e-s,m=(s+e)/2,x=ax=='x'?m:f,z=ax=='x'?f:m;
 mesh(ax=='x'?bxu(L,3,.6,4,3):bxu(.6,3,L,4,3),mBr).position.set(x,1.5,z);
 mesh(ax=='x'?RB(L+.1,.18,.8):RB(.8,.18,L+.1),mCo).position.set(x,3.08,z);
 AB.push(ax=='x'?{x0:s,x1:e,z0:f-.3,z1:f+.3,h:3}:{x0:f-.3,x1:f+.3,z0:s,z1:e,h:3})}
function gap(ax,f,c,o){const x=ax=='x'?c:f,z=ax=='x'?f:c,ox=ax=='x'?0:o,oz=ax=='x'?o:0,w={x,z,ox,oz,bd:[],n:3,tc:0};
 mesh(ax=='x'?bxu(3,.9,.6,4,3):bxu(.6,.9,3,4,3),mBr).position.set(x,.45,z);mesh(ax=='x'?bxu(3,.5,.6,4,3):bxu(.6,.5,3,4,3),mBr).position.set(x,2.75,z);
 AB.push(ax=='x'?{x0:c-1.5,x1:c+1.5,z0:f-.3,z1:f+.3,h:3}:{x0:f-.3,x1:f+.3,z0:c-1.5,z1:c+1.5,h:3});
// 移動判定は元の壁を維持。
// 射撃判定だけ、窓の下壁と上壁に分割する。
const windowCollider = AB[AB.length - 1];

windowCollider.bulletParts = [
  {
    x0: windowCollider.x0,
    x1: windowCollider.x1,
    z0: windowCollider.z0,
    z1: windowCollider.z1,
    y0: 0,
    y1: .9
  },
  {
    x0: windowCollider.x0,
    x1: windowCollider.x1,
    z0: windowCollider.z0,
    z1: windowCollider.z1,
    y0: 2.5,
    y1: 3
  }
];

for(let i=0;i<3;i++){const b=mesh(bxu(3.3,.22,.06,1,1),mPl);b.position.set(x+ox*.36,1.15+i*.52,z+oz*.36);b.rotation.set(0,ax=='x'?0:PI/2,rr(-.07,.07));w.bd.push(b)}WIN.push(w)}
function side(ax,f,a,b,gs,o){let c=a;for(const g of gs){seg(ax,f,c,g-1.5);gap(ax,f,g,o);c=g+1.5}seg(ax,f,c,b)}
side('x',-24,-32,32,[-16,16],-1);side('x',24,-32,32,[-16,16],1);side('z',-32,-24,24,[0],-1);side('z',32,-24,24,[0],1);
/* houses */
function house(x,z,w,d,col){const g=new THREE.Group(),ms=mt(tx(col,200,{l:16,r:18}),.85),mw=mt(null,.5,0,0xe8e2d0);g.position.set(x,0,z);scene.add(g);
 mesh(bxu(w,5,d,5,5),ms,1,g).position.y=2.75;mesh(bxu(w+.3,.5,d+.3,2,.5),mCo,1,g).position.y=.25;
 const s=new THREE.Shape();s.moveTo(-w/2-.6,0);s.lineTo(w/2+.6,0);s.lineTo(0,2.6);s.closePath();const rg=new THREE.ExtrudeGeometry(s,{depth:d+1.2,bevelEnabled:true,bevelThickness:.08,bevelSize:.08,bevelSegments:1});rg.translate(0,0,-(d+1.2)/2);
 const rf=mesh(rg,mt(rep(T_roof,.5),.8),1,g);rf.position.y=5.5;
 mesh(bxu(.9,3.4,.9,.9,.9),mBr,1,g).position.set(w/2-1.4,6.8,-d/4);
 mesh(RB(1.1,2.2,.16),mt(T_wood,.7),1,g).position.set(0,1.6,d/2+.06);const kn=mesh(new THREE.SphereGeometry(.05,8,6),GM[4],0,g);kn.position.set(.4,1.5,d/2+.2);
 mesh(RB(1.4,2.5,.1),mw,1,g).position.set(0,1.65,d/2+.02);
 for(const wx of[-w/3,w/3])for(const[wy,sd]of[[3.3,1]]){mesh(RB(1.5,1.5,.14),mw,0,g).position.set(wx,wy,d/2+.04);mesh(new THREE.PlaneGeometry(1.2,1.2),new THREE.MeshStandardMaterial({color:0x101418,emissive:0x3a2a10,roughness:.2,metalness:.5}),0,g).position.set(wx,wy,d/2+.12);
  for(let i=0;i<2;i++){const b=mesh(bxu(1.6,.16,.05,1,1),mPl,0,g);b.position.set(wx,wy-.3+i*.6,d/2+.2);b.rotation.z=rr(-.15,.15)}}
 for(const sx of[-1,1])mesh(new THREE.CylinderGeometry(.1,.12,3.4,10),mw,1,g).position.set(sx*w*.25,1.7,d/2+1.9);
 mesh(RB(w*.6,.3,2.4),mCo,1,g).position.set(0,.2,d/2+1.2);mesh(RB(w*.62,.2,2.6),mt(T_roof,.8),1,g).position.set(0,3.5,d/2+1.2);
 AB.push({x0:x-w/2,x1:x+w/2,z0:z-d/2,z1:z+d/2,h:5})}
house(-14,-13,11,8,'#8d8470');house(14,-13,10,8,'#6e7c78');
/* wrecked cars (extruded side profile) */
function car(x,z,ry,col){const g=new THREE.Group(),s=new THREE.Shape(),pa=mt(tx(col,320,{r:20}),.5,.4);g.position.set(x,0,z);g.rotation.set(0,ry,rr(-.04,.04));scene.add(g);
 s.moveTo(-2.15,.45);s.bezierCurveTo(-2.2,.7,-2.1,.9,-1.8,.95);s.bezierCurveTo(-1.4,1,-1.2,1.05,-.9,1.4);s.bezierCurveTo(-.7,1.55,.4,1.55,.65,1.35);s.bezierCurveTo(.95,1.1,1.2,.98,1.9,.92);s.bezierCurveTo(2.15,.88,2.2,.7,2.15,.45);
 s.lineTo(1.73,.45);s.absarc(1.35,.45,.38,0,PI,false);s.lineTo(-.97,.45);s.absarc(-1.35,.45,.38,0,PI,false);s.lineTo(-2.15,.45);
 const bg=new THREE.ExtrudeGeometry(s,{depth:1.5,bevelEnabled:true,bevelThickness:.12,bevelSize:.08,bevelSegments:3,curveSegments:14});bg.translate(0,0,-.75);mesh(bg,pa,1,g);
 const gm=new THREE.MeshStandardMaterial({color:0x0a0d12,roughness:.1,metalness:.9,side:THREE.DoubleSide});
 for(const[p,q]of[[[-1.1,1.04],[-.82,1.37],[-.22,1.37],[-.22,1.04]],[[-.1,1.04],[-.1,1.37],[.38,1.37],[.72,1.06]]]){const w=new THREE.Shape();w.moveTo(p[0],p[1]||0);}
 const w1=new THREE.Shape();w1.moveTo(-1.08,1.05);w1.lineTo(-.8,1.37);w1.lineTo(-.2,1.37);w1.lineTo(-.2,1.05);const w2=new THREE.Shape();w2.moveTo(-.05,1.05);w2.lineTo(-.05,1.37);w2.lineTo(.4,1.37);w2.lineTo(.7,1.07);
 for(const w of[w1,w2]){const e=new THREE.ExtrudeGeometry(w,{depth:1.7,bevelEnabled:false});e.translate(0,0,-.85);mesh(e,gm,0,g)}
 for(const[px,py,rz,w]of[[.8,1.2,.77,1.45],[-1.05,1.22,-.71,1.45]]){const p=mesh(new THREE.PlaneGeometry(.46,w),gm,0,g);p.rotation.set(0,0,rz);p.rotation.order='YXZ';p.position.set(px,py,0);p.rotation.y=0;p.geometry.rotateX(0)}
 for(const[wx,wz]of[[1.35,.8],[1.35,-.8],[-1.35,.8],[-1.35,-.8]]){const t=mesh(new THREE.TorusGeometry(.27,.12,10,18),mt(null,.9,0,0x111111),1,g);t.position.set(wx,.33,wz);const r=mesh(new THREE.CylinderGeometry(.19,.19,.16,12),GM[0],0,g);r.rotation.x=PI/2;r.position.set(wx,.33,wz+(wz>0?.02:-.02))}
 for(const hz of[-.55,.55]){const l=mesh(new THREE.SphereGeometry(.12,10,8),new THREE.MeshStandardMaterial({color:0xddddcc,emissive:0x333322}),0,g);l.scale.set(1,.7,1.3);l.position.set(2.1,.76,hz);const t=mesh(new THREE.SphereGeometry(.1,8,6),new THREE.MeshStandardMaterial({color:0x660000,emissive:0x220000}),0,g);t.scale.set(.6,.6,1.4);t.position.set(-2.14,.8,hz)}
 mesh(RB(.14,.2,1.7),GM[0],1,g).position.set(2.2,.5,0);mesh(RB(.14,.2,1.7),GM[0],1,g).position.set(-2.2,.5,0);
 CC.push({x:x+Math.cos(ry)*1.1,z:z-Math.sin(ry)*1.1,r:1.05,h:1.6},{x:x-Math.cos(ry)*1.1,z:z+Math.sin(ry)*1.1,r:1.05,h:1.6})}
car(0,-3,.35,'#7a2d2d');car(-20,11,-.6,'#2d4a63');car(21,10,1.25,'#6d6a58');
/* dead trees, crates, barrels */
const mBk=mt(T_bark,.9);
function tree(x,z){const g=new THREE.Group();g.position.set(x,0,z);scene.add(g);mesh(LT([[.42,0],[.32,1.2],[.22,3],[.14,5.2]],9),mBk,1,g);
 for(let i=0;i<7;i++){const L=rr(1.6,3),b=new THREE.CylinderGeometry(.02,.09,L,5);b.translate(0,L/2,0);const o=mesh(b,mBk,1,g);o.position.y=rr(2.6,5);o.rotation.set(0,rr(0,6.28),rr(.5,1.1))}CC.push({x,z,r:.45,h:6})}
