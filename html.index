/* collision / rays */
function push(o,r){for(const b of AB){const px=cl(o.x,b.x0,b.x1),pz=cl(o.z,b.z0,b.z1),dx=o.x-px,dz=o.z-pz,d=H(dx,dz);if(d<r){if(d>.001){o.x=px+dx/d*r;o.z=pz+dz/d*r}else o.x+=r}}
 for(const c of CC){const dx=o.x-c.x,dz=o.z-c.z,d=H(dx,dz),m=r+c.r;if(d<m&&d>.001){o.x=c.x+dx/d*m;o.z=c.z+dz/d*m}}}
function rayMap(o, d) {
  let nearest = 300;

  function testBox(box) {
    let enter = 0;
    let exit = nearest;

    const ranges = [
      ['x', box.x0, box.x1],
      ['y', box.y0 ?? 0, box.y1 ?? box.h],
      ['z', box.z0, box.z1]
    ];

    for (const [axis, low, high] of ranges) {
      const origin = o[axis];
      const direction = d[axis];

      if (Math.abs(direction) < 1e-6) {
        if (origin < low || origin > high) return;
        continue;
      }

      let near = (low - origin) / direction;
      let far = (high - origin) / direction;

      if (near > far) {
        [near, far] = [far, near];
      }

      enter = Math.max(enter, near);
      exit = Math.min(exit, far);

      if (enter > exit) return;
    }

    if (exit > 0 && enter < nearest) {
      nearest = Math.max(.001, enter);
    }
  }

  // 建物・壁・木箱。
  // 窓だけは上下の壁を個別に検査する。
  for (const box of AB) {
    if (box.bulletParts) {
      for (const part of box.bulletParts) {
        testBox(part);
      }
    } else {
      testBox(box);
    }
  }

  // 車・木・ドラム缶などの円柱判定。
  for (const c of CC) {
    const ox = o.x - c.x;
    const oz = o.z - c.z;
    const a = d.x * d.x + d.z * d.z;
    const b = ox * d.x + oz * d.z;
    const k = ox * ox + oz * oz - c.r * c.r;
    const discriminant = b * b - a * k;

    if (discriminant < 0 || a < 1e-6) continue;

    const distance = (-b - Math.sqrt(discriminant)) / a;
    const height = o.y + d.y * distance;

    if (
      distance > 0 &&
      distance < nearest &&
      height > 0 &&
      height < c.h
    ) {
      nearest = distance;
    }
  }

  // 地面。
  if (d.y < -1e-6) {
    const distance = -o.y / d.y;

    if (distance > 0 && distance < nearest) {
      nearest = distance;
    }
  }

  return nearest;
}

function rs3(o,d,x,y,z,r){const ox=o.x-x,oy=o.y-y,oz=o.z-z,b=ox*d.x+oy*d.y+oz*d.z,h=b*b-(ox*ox+oy*oy+oz*oz-r*r);if(h<0)return 1e9;const t=-b-Math.sqrt(h);return t>0?t:1e9}
